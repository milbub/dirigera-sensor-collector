# Example configuration for dirigera-sensor-collector.
#
# Copy to .env and adjust:  cp .env.example .env && chmod 640 .env
#
# Plain NAME=value lines only (systemd EnvironmentFile format): no "export",
# no "source". Commented-out values show the defaults.

# --- DIRIGERA hub (required) -------------------------------------------------
DIRIGERA_IP=192.168.1.20
DIRIGERA_TOKEN=replace-with-token-from-generate-token

# --- General -----------------------------------------------------------------
#POLL_INTERVAL_SECONDS=10
#LOG_LEVEL=INFO

# --- InfluxDB 2.x ------------------------------------------------------------
INFLUX_ENABLED=false
# Print line protocol instead of writing; overrides INFLUX_ENABLED.
#INFLUX_DRY_RUN=false
#INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
#INFLUX_BUCKET=sensors
#INFLUX_MEASUREMENT=ikea_environment_sensor
# Comma-separated; fields: temperature, humidity, co2, pm25, voc_index,
# battery_percentage; tags: sensor_id, name, model, room.
#INFLUX_IGNORED_FIELDS=
#INFLUX_IGNORED_TAGS=

# Hold writes after a device reconnects from a longer outage (0 disables).
#INFLUX_RECOVERY_HOLD_SECONDS=1800
#INFLUX_RECOVERY_HOLD_MIN_UNREACHABLE_SAMPLES=2

# --- ALPSTUGA display schedule (optional) ------------------------------------
# Endpoint IDs including the _1 suffix; leave empty to disable scheduling.
#ALPSTUGA_DISPLAY_CONTROL_IDS=00000000-0000-0000-0000-000000000000_1
# System local time, HH:MM:SS.
#ALPSTUGA_DISPLAY_CONTROL_OFF_TIME=22:00:00
#ALPSTUGA_DISPLAY_CONTROL_ON_TIME=06:30:00
